{
  "printWidth": 100,
  "plugins": ["@ianvs/prettier-plugin-sort-imports", "prettier-plugin-svelte"],
  "overrides": [
    {
      "files": "*.svelte",
      "options": {
        "parser": "svelte"
      }
    }
  ],
  "svelteAllowShorthand": true,
  "svelteIndentScriptAndStyle": true,
  "importOrder": [
    "^svelte",
    "^\\$app/",
    "^#lib/",
    "<THIRD_PARTY_MODULES>",
    "",
    "^@/",
    "^[./]",
    "",
    "\\.css$"
  ]
}
